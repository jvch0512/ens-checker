;;; ens.scm: ENS facts-file audit. No dependencies beyond Chicken core.
(import (chicken base) (chicken string) (chicken sort) (chicken format))

(define (filter pred lst)
  (let loop ((l lst) (acc '()))
    (cond ((null? l) (reverse acc))
          ((pred (car l)) (loop (cdr l) (cons (car l) acc)))
          (else (loop (cdr l) acc)))))

(define (str-index s ch)
  (let loop ((i 0))
    (cond ((>= i (string-length s)) #f)
          ((char=? (string-ref s i) ch) i)
          (else (loop (+ i 1))))))

(define (trim s)
  (let* ((n (string-length s))
         (a (let loop ((i 0)) (if (and (< i n) (char-whitespace? (string-ref s i))) (loop (+ i 1)) i)))
         (b (let loop ((j n)) (if (and (> j a) (char-whitespace? (string-ref s (- j 1)))) (loop (- j 1)) j))))
    (substring s a b)))

(define (lower s) (list->string (map char-downcase (string->list s))))
(define (upper s) (list->string (map char-upcase (string->list s))))

(define (split-lines text)
  (let loop ((cs (string->list text)) (cur '()) (acc '()))
    (cond ((null? cs) (reverse (cons (list->string (reverse cur)) acc)))
          ((char=? (car cs) #\newline) (loop (cdr cs) '() (cons (list->string (reverse cur)) acc)))
          ((char=? (car cs) #\return) (loop (cdr cs) cur acc))
          (else (loop (cdr cs) (cons (car cs) cur) acc)))))

(define (rank sev)
  (cond ((string=? sev "critical") 0) ((string=? sev "high") 1)
        ((string=? sev "medium") 2) ((string=? sev "low") 3) (else 4)))

;; finding: (sev rule file line msg)
(define (finding sev rule file line msg) (list sev rule file line msg))
(define (f-sev f) (list-ref f 0))
(define (f-rule f) (list-ref f 1))
(define (f-file f) (list-ref f 2))
(define (f-line f) (list-ref f 3))
(define (f-msg f) (list-ref f 4))
(define (f-where f)
  (if (> (f-line f) 0) (string-append (f-file f) ":" (number->string (f-line f))) (f-file f)))

;; days since 1970-01-01
(define (dayno y m d)
  (let* ((y2 (if (<= m 2) (- y 1) y))
         (era (quotient (if (>= y2 0) y2 (- y2 399)) 400))
         (yoe (- y2 (* era 400)))
         (mp (if (> m 2) (- m 3) (+ m 9)))
         (doy (+ (quotient (+ (* 153 mp) 2) 5) (- d 1)))
         (doe (+ (* yoe 365) (quotient yoe 4) (- (quotient yoe 100)) doy)))
    (- (+ (* era 146097) doe) 719468)))

(define (all-digits? s) (and (> (string-length s) 0) (every-char char-numeric? s)))
(define (every-char p s) (let loop ((i 0)) (or (>= i (string-length s)) (and (p (string-ref s i)) (loop (+ i 1))))))

(define (parse-date str)
  (let ((s (trim str)))
    (and (= (string-length s) 10)
         (char=? (string-ref s 4) #\-) (char=? (string-ref s 7) #\-)
         (all-digits? (substring s 0 4)) (all-digits? (substring s 5 7)) (all-digits? (substring s 8 10))
         (let ((y (string->number (substring s 0 4))) (m (string->number (substring s 5 7))) (d (string->number (substring s 8 10))))
           (and (>= m 1) (<= m 12) (>= d 1) (<= d 31) (dayno y m d))))))

;; facts: list of (key value line)
(define (parse-facts text)
  (let loop ((ls (split-lines text)) (n 1) (acc '()))
    (if (null? ls)
        (reverse acc)
        (let* ((t (trim (car ls))))
          (if (or (string=? t "") (char=? (string-ref t 0) #\#))
              (loop (cdr ls) (+ n 1) acc)
              (let ((i (str-index t #\:)))
                (if (or (not i) (= i 0))
                    (loop (cdr ls) (+ n 1) acc)
                    (loop (cdr ls) (+ n 1)
                          (cons (list (lower (trim (substring t 0 i))) (trim (substring t (+ i 1) (string-length t))) n) acc)))))))))

(define (fact facts key)
  (let loop ((l facts) (found #f))
    (cond ((null? l) found)
          ((string=? (car (car l)) key) (loop (cdr l) (car l)))
          (else (loop (cdr l) found)))))

(define (fval f) (cadr f))
(define (fline f) (caddr f))
(define (yes? s) (let ((v (lower s))) (or (string=? v "yes") (string=? v "true") (string=? v "1"))))

(define (cat-index c)
  (let ((u (upper c)))
    (cond ((string=? u "BASICA") 0) ((string=? u "MEDIA") 1) ((string=? u "ALTA") 2) (else #f))))

(define pwd-min (vector 8 12 14))
(define log-min (vector 90 180 365))
(define patch-max (vector 90 30 15))
(define backup-max (vector 7 1 1))

(define (audit text label today)
  (let* ((facts (parse-facts text))
         (out '())
         (add! (lambda (sev rule line msg) (set! out (cons (finding sev rule label line msg) out))))
         (catf (fact facts "category"))
         (ci (and catf (cat-index (fval catf)))))
    (cond
      ((null? facts) (add! "info" "ENS000" 0 "empty file, nothing to check"))
      (else
       (when (not ci)
         (add! "info" "ENS000" (if catf (fline catf) 0)
               (if catf (string-append "unknown category '" (fval catf) "', MEDIA assumed") "no category declared, MEDIA assumed")))
       (let* ((c (or ci 1))
              (cname (vector-ref (vector "BASICA" "MEDIA" "ALTA") c))
              (num (lambda (key) (let ((f (fact facts key))) (and f (string->number (fval f))))))
              (check-num
               (lambda (key rule sev limit-vec cmp what measure)
                 (let ((f (fact facts key)) (v (num key)) (lim (vector-ref limit-vec c)))
                   (cond ((or (not f) (not v))
                          (add! sev rule (if f (fline f) 0) (string-append what " not declared (" measure ")")))
                         ((not (cmp v lim))
                          (add! sev rule (fline f)
                                (string-append what " is " (fval f) ", the ENS " cname " reference value is "
                                               (if (eq? cmp >=) "at least " "at most ") (number->string lim) " (" measure ")"))))))))
         (check-num "password_min_length" "ENS001" "medium" pwd-min >= "password minimum length" "op.acc.6")
         (let ((f (fact facts "mfa_admin")))
           (when (or (not f) (not (yes? (fval f))))
             (add! (if (= c 0) "medium" "high") "ENS002" (if f (fline f) 0)
                   (string-append "administrators do not use MFA" (if f "" " (not declared)") " (op.acc.6 R8)"))))
         (check-num "log_retention_days" "ENS003" "medium" log-min >= "log retention in days" "op.exp.8 R3")
         (check-num "patch_max_age_days" "ENS004" "medium" patch-max <= "oldest unapplied patch in days" "op.exp.4")
         (when (>= c 1)
           (let ((f (fact facts "disk_encryption")))
             (when (or (not f) (not (yes? (fval f))))
               (add! "high" "ENS005" (if f (fline f) 0) (string-append "no disk encryption" (if f "" " declared") " (mp.si.2)")))))
         (let ((f (fact facts "tls_min_version")) (v (num "tls_min_version")))
           (cond ((or (not f) (not v)) (add! "high" "ENS006" (if f (fline f) 0) "minimum TLS version not declared (mp.com.2, mp.com.3)"))
                 ((< v 1.2) (add! "high" "ENS006" (fline f) (string-append "minimum TLS version is " (fval f) ", expected 1.2 or higher (mp.com.2, mp.com.3)")))))
         (check-num "backup_frequency_days" "ENS007" "medium" backup-max <= "backup interval in days" "mp.info.6")
         (let ((f (fact facts "admin_accounts_shared")))
           (when (and f (yes? (fval f)))
             (add! "high" "ENS008" (fline f) "administrator accounts are shared between people (op.acc.1)")))
         (let* ((f (fact facts "risk_analysis_date")) (d (and f (parse-date (fval f)))))
           (cond ((not f) (add! "medium" "ENS009" 0 "no risk analysis date declared (op.pl.1)"))
                 ((not d) (add! "medium" "ENS009" (fline f) (string-append "risk analysis date '" (fval f) "' is not YYYY-MM-DD (op.pl.1)")))
                 ((> (- today d) 365) (add! "medium" "ENS009" (fline f) (string-append "risk analysis dated " (fval f) " is older than 12 months (op.pl.1)")))))
         (when (>= c 1)
           (let ((f (fact facts "incident_register")))
             (when (or (not f) (not (yes? (fval f))))
               (add! "medium" "ENS010" (if f (fline f) 0) (string-append "no incident register" (if f "" " declared") " (op.exp.7)")))))
         (let ((f (fact facts "time_sync")))
           (when (or (not f) (not (yes? (fval f))))
             (add! "low" "ENS011" (if f (fline f) 0) (string-append "clocks are not synchronised" (if f "" " (not declared)") " (op.exp.8 R2)")))))))
    (reverse out)))

(define (finding<? a b)
  (let ((ra (rank (f-sev a))) (rb (rank (f-sev b))))
    (cond ((< ra rb) #t) ((> ra rb) #f)
          ((string<? (f-file a) (f-file b)) #t) ((string<? (f-file b) (f-file a)) #f)
          ((< (f-line a) (f-line b)) #t) ((> (f-line a) (f-line b)) #f)
          (else (string<? (f-rule a) (f-rule b))))))

(define (sort-findings l) (sort l finding<?))
